{
  "name": "@openworkflowspec/sdk",
  "version": "1.0.3-alpha8",
  "schemaVersion": "1.0.3",
  "supportedDslVersions": ">=1.0.0-0 <=1.0.3",
  "description": "Typescript SDK for Open Workflow Specification",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "browser": "./index.umd.min.js",
  "types": "./index.d.mts",
  "typings": "./index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.cjs",
    "*.mjs",
    "*.js",
    "*.d.ts",
    "*.d.cts",
    "*.d.mts",
    "*.map",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-workflow-specification/sdk-typescript.git"
  },
  "author": {
    "name": "Open Workflow Specification Contributors",
    "url": "https://open-workflow-specification.org"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/open-workflow-specification/sdk-typescript/issues"
  },
  "homepage": "https://open-workflow-specification.org",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^5.2.1",
    "semver": "^7.8.5"
  }
}
